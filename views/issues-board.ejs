<!DOCTYPE html>
<html>
  <%- include('head'); %>
  <body class="issues-board-light">
    <div class="details">
      <header class="details__header">
        <a href="/" class="btn btn--back">←</a>
        <h1 class="details__title">Issues Board</h1>
      </header>

      <% const activeLabels = labels ? labels.split(',') : [] %>
      <main class="details__main">
        <div class="label-picker">
          <span class="label-picker__title"><%= activeLabels.length ? 'Label ativa' : 'Todas as labels' %></span>
          <div class="label-cloud">
            <% issuesSummary.labels.forEach(label => { %>
            <span
              class="label-tag <%= activeLabels.includes(label.name) ? 'label-tag--active' : '' %>"
              data-label="<%= label.name %>"
            ><%= label.name %> (<%= label.total %>)</span>
            <% }) %>
          </div>
        </div>

        <section class="details__section">
          <h2 class="details__section-title">📈 Issues ao longo do tempo</h2>
          <p class="issues-board__hint">Clique em um ponto do gráfico para abrir os detalhes daquela semana no painel lateral.</p>
          <div class="issues-board__chart-container">
            <canvas id="issuesChart"></canvas>
          </div>
        </section>

        <section class="details__section">
          <h2 class="details__section-title">🕓 Acompanhamento por período</h2>
          <p class="issues-board__hint">Selecione a data do último alinhamento para visualizar o que foi aberto ou fechado de lá até hoje.</p>
          <form class="checkpoint-form" method="GET" action="">
            <input type="hidden" name="labels" value="<%= labels %>">
            <input
              class="checkpoint-form__input"
              type="date"
              name="since"
              value="<%= sinceLastCheck ? sinceLastCheck.date : '' %>"
            >
            <button type="submit" class="btn btn--primary">Filtrar novidades</button>
          </form>
        </section>

        <% if (sinceLastCheck) { %>
        <section class="details__section">
          <h2 class="details__section-title">🕓 Issues desde <%= sinceLastCheck.date %> (<%= sinceLastCheck.issues.length %>)</h2>
          <div class="details__table-container">
            <table class="details__table">
              <thead>
                <tr><th class="details__table-header--status">Status</th><th class="details__table-header--project">Projeto</th><th>Título</th><th class="details__table-header--labels">Labels</th><th class="details__table-header--center details__table-header--link">GitLab</th></tr>
              </thead>
              <tbody>
                <% sinceLastCheck.issues.forEach((issue) => { %>
                <tr>
                  <td class="details__table-cell details__table-cell--status">
                    <span class="status-badge status-badge--<%= issue.state %>"><%= issue.state === 'opened' ? 'Aberta' : 'Fechada' %></span>
                  </td>
                  <td class="details__table-cell details__table-cell--project" title="<%= issue.projectName %>"><%= issue.projectName %></td>
                  <td class="details__table-cell details__table-cell--title" title="<%= issue.title %>"><%= issue.title %></td>
                  <td class="details__table-cell details__table-cell--labels" title="<%= (issue.labels || []).join(', ') %>"><%= (issue.labels || []).join(', ') %></td>
                  <td class="details__table-cell details__table-cell--link">
                    <% if (issue.webUrl) { %>
                    <a href="<%= issue.webUrl %>" class="btn btn--link" target="_blank" rel="noopener noreferrer">#<%= issue.id %></a>
                    <% } else { %>
                    #<%= issue.id %>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
                <% if (!sinceLastCheck.issues.length) { %>
                <tr><td class="details__table-cell" colspan="5">Nenhuma issue aberta ou fechada desde essa data.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <section class="details__section">
          <h2 class="details__section-title">📊 Ranking de projetos</h2>
          <p class="issues-board__hint">Clique em um projeto para ver as issues dele no GitLab.</p>
          <ul class="ranking-list">
            <% const labelParams = activeLabels.filter(Boolean).map((label) => `label_name[]=${encodeURIComponent(label)}`).join('&') %>
            <% issuesSummary.totalIssuesByProject.forEach((project, index) => { %>
            <li>
              <% if (project.issuesUrl) { %>
              <a
                class="ranking-item"
                href="<%= project.issuesUrl %><%= labelParams ? '?' + labelParams : '' %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="ranking-title"><%= index + 1 %>. <%= project.name %></div>
                <div class="ranking-meta">
                  <strong><%= project.totalIssues %></strong> issue<%= project.totalIssues !== 1 ? 's' : '' %>
                </div>
              </a>
              <% } else { %>
              <div class="ranking-item">
                <div class="ranking-title"><%= index + 1 %>. <%= project.name %></div>
                <div class="ranking-meta">
                  <strong><%= project.totalIssues %></strong> issue<%= project.totalIssues !== 1 ? 's' : '' %>
                </div>
              </div>
              <% } %>
            </li>
            <% }) %>
          </ul>
        </section>
      </main>
    </div>

    <div id="issue-drawer-backdrop" class="issue-drawer-backdrop"></div>
    <aside id="issue-drawer" class="issue-drawer" aria-hidden="true">
      <div class="issue-drawer__header">
        <h2 class="issue-drawer__title" id="issue-drawer-title">Detalhes da semana</h2>
        <button type="button" class="issue-drawer__close" id="issue-drawer-close" aria-label="Fechar">&times;</button>
      </div>
      <div class="issue-drawer__body" id="issue-drawer-body">
        <p class="issues-board__hint">Clique em um ponto do gráfico para ver quais issues foram abertas, fechadas ou seguem em aberto naquela semana.</p>
      </div>
    </aside>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      document.querySelectorAll('.label-tag').forEach(
        (element) => {
          element.onclick = (evt) => {
            const params = new URLSearchParams(document.location.search)
            params.set('labels', evt.currentTarget.dataset.label)
            document.location.search = params.toString()
          }
        }
      )
    </script>

    <script>
      const data = <%- JSON.stringify(issuesCountByWeek) %>

      const { notClosedIssuesByWeek, openedIssuesByWeek, closedIssuesByWeek } = data

      // Prepare the data for the chart
      const chartLabels = notClosedIssuesByWeek.map((entry) => entry.week)

      const notClosedIssuesByWeekCounts = notClosedIssuesByWeek.map((entry) => entry.count)
      const openedIssuesByWeekCounts = openedIssuesByWeek.map((entry) => entry.count)
      const closedIssuesByWeekCounts = closedIssuesByWeek.map((entry) => entry.count)

      // Each dataset index maps to its own week list, so a click can look up the matching issues
      const datasetsByIndex = [notClosedIssuesByWeek, openedIssuesByWeek, closedIssuesByWeek]
      const datasetLabels = ['Open Issues', 'Opened Issues By Week', 'Closed Issues By Week']

      function escapeHtml(value) {
        const div = document.createElement('div')
        div.innerText = value == null ? '' : value
        return div.innerHTML
      }

      const drawer = document.getElementById('issue-drawer')
      const drawerBackdrop = document.getElementById('issue-drawer-backdrop')
      const drawerTitle = document.getElementById('issue-drawer-title')
      const drawerBody = document.getElementById('issue-drawer-body')

      function openDrawer() {
        drawer.classList.add('issue-drawer--open')
        drawerBackdrop.classList.add('issue-drawer-backdrop--visible')
        drawer.setAttribute('aria-hidden', 'false')
      }

      function closeDrawer() {
        drawer.classList.remove('issue-drawer--open')
        drawerBackdrop.classList.remove('issue-drawer-backdrop--visible')
        drawer.setAttribute('aria-hidden', 'true')
      }

      document.getElementById('issue-drawer-close').onclick = closeDrawer
      drawerBackdrop.onclick = closeDrawer
      document.addEventListener('keydown', (evt) => {
        if (evt.key === 'Escape') closeDrawer()
      })

      function renderIssueDetails(datasetIndex, weekIndex) {
        const week = datasetsByIndex[datasetIndex][weekIndex]

        drawerTitle.textContent = `${datasetLabels[datasetIndex]} – ${week ? week.week : ''}`

        if (!week || !week.issues.length) {
          drawerBody.innerHTML = `<p class="issues-board__hint">Nenhuma issue encontrada nesse período.</p>`
          openDrawer()
          return
        }

        const items = week.issues.map((issue) => {
          const stateLabel = issue.state === 'opened' ? 'Aberta' : 'Fechada'
          return `
          <div class="issue-drawer-item">
            <div class="issue-drawer-item__title">${escapeHtml(issue.title)}</div>
            <div class="issue-drawer-item__meta">
              <span class="status-badge status-badge--${issue.state}">${stateLabel}</span>
              <span>•</span>
              <span>${escapeHtml(issue.projectName)}</span>
            </div>
            ${(issue.labels || []).length ? `<div class="issue-drawer-item__labels">${(issue.labels || []).map(escapeHtml).join(', ')}</div>` : ''}
            ${issue.webUrl ? `<a href="${issue.webUrl}" class="btn btn--link issue-drawer-item__link" target="_blank" rel="noopener noreferrer">Ver no GitLab #${issue.id}</a>` : `<span>#${issue.id}</span>`}
          </div>
        `
        }).join('')

        drawerBody.innerHTML = items
        openDrawer()
      }

      // Set up the chart
      const ctx = document.getElementById('issuesChart').getContext('2d')
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: chartLabels,
          datasets: [{
            label: datasetLabels[0],
            data: notClosedIssuesByWeekCounts,
            borderColor: 'rgba(234, 179, 8, 1)',
            backgroundColor: 'rgba(255, 255, 255, 0)',
            borderWidth: 2,
            fill: true,
          }, {
            label: datasetLabels[1],
            data: openedIssuesByWeekCounts,
            borderColor: 'rgba(220, 38, 38, 1)',
            backgroundColor: 'rgba(255, 255, 255, 0)',
            borderWidth: 2,
            fill: true,
          }, {
            label: datasetLabels[2],
            data: closedIssuesByWeekCounts,
            borderColor: 'rgba(22, 163, 74, 1)',
            backgroundColor: 'rgba(255, 255, 255, 0)',
            borderWidth: 2,
            fill: true,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          onClick: (evt, elements) => {
            if (!elements.length) return
            const { datasetIndex, index } = elements[0]
            renderIssueDetails(datasetIndex, index)
          },
          plugins: {
            legend: { labels: { color: 'rgba(17, 24, 39, 0.9)' } }
          },
          scales: {
            x: {
              type: 'category',
              title: { display: true, text: 'Semana', color: 'rgba(17, 24, 39, 0.9)' },
              ticks: { autoSkip: true, maxTicksLimit: 20, color: 'rgba(17, 24, 39, 0.7)' },
              grid: { color: 'rgba(17, 24, 39, 0.08)' },
              reverse: false,
            },
            y: {
              beginAtZero: true,
              title: { display: true, text: 'Quantidade de Issues', color: 'rgba(17, 24, 39, 0.9)' },
              ticks: { color: 'rgba(17, 24, 39, 0.7)' },
              grid: { color: 'rgba(17, 24, 39, 0.08)' },
            },
          },
        },
      })
    </script>
  </body>
</html>

